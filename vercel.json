{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix ui ci",
  "buildCommand": "npm --prefix ui run build",
  "outputDirectory": "ui/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "{aura/**,schemas/**}",
      "excludeFiles": "{ui/**,.venv/**,.history/**,.agents/**,.claude/**,docs/**,tests/**,data/**,keys/**,wheelhouse/**,*.md}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
